# =============================================================================
# SpaceToby — Environment Configuration Example
# Copy this file to .env and fill in the required values.
# NEVER commit real secrets or API keys to version control!
# =============================================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# --- PostgreSQL / Prisma Database ---
# Local Docker Compose PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spacetoby?schema=public"

# --- Local email/password authentication ---
# Generate a unique random secret (at least 32 characters); required by the API.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"

# --- Anti-Cheat & Session Limits ---
MAX_SPEED_UNITS_PER_SEC=850
MAX_KILLS_PER_SEC=6
SESSION_MAX_DURATION_MS=3600000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- PixelLab MCP Configuration (Used by asset generation scripts only) ---
PIXELLAB_MCP_URL="https://api.pixellab.ai/mcp"
PIXELLAB_API_KEY="your-pixellab-api-key-here"
