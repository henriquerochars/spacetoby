# =============================================================================
# SpaceToby — Environment Configuration Example
# Copy this file to .env and fill in the required values.
# NEVER commit real secrets or API keys to version control!
# =============================================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# --- PostgreSQL / Prisma Database ---
# Local Docker Compose PostgreSQL or Supabase local DB connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spacetoby?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/spacetoby?schema=public"

# --- Supabase Authentication ---
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
SUPABASE_JWKS_URI="http://localhost:54321/auth/v1/.well-known/jwks.json"

# Allow deterministic local/dev auth tokens for offline local testing & E2E tests
ALLOW_DEV_AUTH="true"

# --- Anti-Cheat & Session Limits ---
MAX_SPEED_UNITS_PER_SEC=850
MAX_KILLS_PER_SEC=6
SESSION_MAX_DURATION_MS=3600000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- PixelLab MCP Configuration (Used by asset generation scripts only) ---
PIXELLAB_MCP_URL="https://api.pixellab.ai/mcp"
PIXELLAB_API_KEY="your-pixellab-api-key-here"
