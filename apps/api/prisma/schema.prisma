// =============================================================================
// SpaceToby — Prisma Schema (PostgreSQL / Supabase)
// Normalized schema with indexed leaderboard queries and session validation.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RunStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ValidationStatus {
  PENDING
  VALID
  REJECTED
}

model Player {
  id           String        @id @default(uuid()) @db.Uuid
  authUserId   String        @unique @map("auth_user_id")
  nickname     String        @unique @db.VarChar(32)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  gameSessions GameSession[]

  @@index([nickname])
  @@map("players")
}

model GameSession {
  id               String           @id @default(uuid()) @db.Uuid
  playerId         String           @map("player_id") @db.Uuid
  player           Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  startedAt        DateTime         @default(now()) @map("started_at")
  finishedAt       DateTime?        @map("finished_at")
  durationMs       Int              @default(0) @map("duration_ms")
  distance         Int              @default(0)
  enemiesKilled    Int              @default(0) @map("enemies_killed")
  status           RunStatus        @default(IN_PROGRESS)
  validationStatus ValidationStatus @default(PENDING) @map("validation_status")
  validationReason String?          @map("validation_reason")
  createdAt        DateTime         @default(now()) @map("created_at")
  events           GameEvent[]

  // Composite indexes for fast global leaderboard & personal best queries
  @@index([playerId, status, validationStatus])
  @@index([status, validationStatus, enemiesKilled(sort: Desc), finishedAt(sort: Asc)])
  @@index([status, validationStatus, distance(sort: Desc), finishedAt(sort: Asc)])
  @@map("game_sessions")
}

model GameEvent {
  id                String      @id @default(uuid()) @db.Uuid
  sessionId         String      @map("session_id") @db.Uuid
  session           GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type              String      @db.VarChar(48)
  timestampOffsetMs Int         @map("timestamp_offset_ms")
  value             Int?
  createdAt         DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("game_events")
}
